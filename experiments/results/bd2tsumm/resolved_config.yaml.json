  "cleaning": {
    "unicode_form": "NFKC",
    "collapse_whitespace": true,
    "dedup_exact": true,
    "replace_urls": true,
    "replace_mentions": true,
    "placeholder_style": "plain",
    "keep_hashtag_text": true,
    "strip_rt_prefix": false,
    "strip_emoji": false,
    "drop_empty_after_clean": true
  },
  "long_context": {
    "mode": "sliding_window",
    "allow_prefix_truncation": false,
    "max_model_tokens": 1024,
    "overlap_tokens": 256,
    "sentence_boundary": true,
    "merge_entities_by_kb_id": true,
    "infer_cross_window_relations": false,
    "tokenizer_path": "/root/autodl-fs/zyq/models/t5-large",
    "allow_mock_tokenizer": false
  },
  "compkg": {
    "variant": "S2-K_PT",
    "backend": "real",
    "higher_is_better": true,
    "treat_as_distance": false,
    "wTT": 1.0,
    "wTM": 1.0,
    "wME": 0.5,
    "wEE": 0.0,
    "wl_t": 1,
    "use_emb_labels": false,
    "use_node_labels": true,
    "use_edge_labels": 2,
    "dreeam_source_dir": "/root/autodl-tmp/FactGraphGAWL/experiments/bd2tsumm/test",
    "dreeam_candidate_dir": "/root/autodl-tmp/FactGraphGAWL/experiments/bd2tsumm/dreeam_candidates",
    "cache_source_graphs": true,
    "cache_candidate_graphs": true
  },
  "rouge": {
    "package": "rouge-score",
    "use_stemmer": true,
    "metrics": [
      "rouge1",
      "rouge2",
      "rougeL"
    ],
    "multi_reference_aggregation": "mean"
  },
  "analysis": {
    "min_systems_for_event_corr": 3,
    "min_n_for_corr": 3,
    "min_event_coverage": 1.0,
    "bootstrap_n": 10000,
    "bootstrap_min_n": 3,
    "dpi": 300
  },
  "output": {
    "prepared_sources": "prepared_sources.jsonl",
    "prepared_candidates": "prepared_candidates.jsonl",
    "prepared_references": "prepared_references.jsonl",
    "data_validation": "data_validation.json",
